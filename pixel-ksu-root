#!/usr/bin/env bash
#
# pixel-ksu-root — obtain temporary kernel R/W on a stock, locked-bootloader
# Google Pixel via a userspace kernel exploit, then late-load a KernelSU
# loadable kernel module (LKM) and hand control to the installed KernelSU
# manager. Manager-agnostic: works with any KernelSU variant.
#
# Flow: preflight -> resolve target -> derive ksud from manager -> obtain root
#       -> late-load -> verify -> teardown staging -> report. Everything is
#       driven over `adb shell` from the host for deterministic control flow
#       and full logs.
#
# Selecting what to run (runner/README.md, "Foreign-chain contract"):
#   RECIPE       recipe to drive, by the SAME name the build uses  (--recipe)
#                unset  => the built-in GhostLock path, which reads no manifest
#                ghostlock / cve64560 / ... => resolve runner/stages/<entry>/stage.toml
#                          through runner/scripts/resolve-recipe.py, exactly as
#                          `make TARGET=<t> RECIPE=<name>` does, and drive the
#                          entry through its declared {invoke, markers,
#                          exit-code map, provides} contract.
#   TARGET       codename-build for --print-contract without a device (--target)
#   --debug-panic      run mode for reading a panic's kernel record. Stage
#                      GhostLock, then reach a fresh post-panic boot and root it
#                      IN PLACE (no reboot -- a reboot clears the record) to dump
#                      /sys/fs/pstore. With --recipe <cve> that recipe is the
#                      panic TRIGGER: it is fired under a connection watcher and
#                      killed the instant it drops the phone, then GhostLock roots
#                      the boot it left. Without a recipe, provoke the crash
#                      yourself (an app, a fuzzer) while it waits.
#   --print-contract   print the resolved contract and the exact device command
#                      it renders, then exit. Touches no phone when TARGET is set.
#
# A recipe whose chain declares no CAP_SU handoff (cve64560) is a HUNT, not a
# root: the runner drives the entry, classifies and archives every shot, and
# skips manager detection, ksud derivation and late-load. CVE-2026-64560 has
# never rooted a device — see cves/cve-2026-64560/README.md.
#
# Environment / flags:
#   SERIAL       adb serial for a specific device            (--serial)
#   MANAGER_PKG  installed KernelSU manager package          (--manager)
#                required unless auto-detected (see runner/lib/install.sh:detect_manager)
#   KMI          override the resolved kernel module interface (--kmi)
#   CLIENT_UID   uid granted root by the exploit (default 2000, the adb shell)
#   APP_UID      manager app uid the daemon authorizes (default: manager's uid)
#   ROOT_MAX     root attempts before giving up     (default 12)
#   VERIFY_TRIES driver version polls after load    (default 30)
#
# Shot budgets and timing (runner/README.md, "Shot classification"). A shot that never
# started (REFUSED) or that panicked spends its OWN budget, not an attempt, so
# ROOT_MAX counts classifiable attempts:
#   REFUSED_MAX  shots that produced no output at all (default 8)
#   PANIC_MAX    reboots tolerated across the run    (default 10)
#   REFUSED_WALL seconds under which a silent shot is a refusal (default 5)
#   SHOT_TIMEOUT wall seconds before a shot is parked or killed (default 600)
#   SETTLE_SECS  uptime a shot should see before firing         (default 45)
# Every shot's device log is archived under logs/shots/<run>/ with an index.tsv.
# SHOT_TIMEOUT's default is derived from measured shot durations — the
# derivation is with the assignment below.
set -u

REPO="$(cd "$(dirname "$0")" && pwd)"
RUN="$REPO/runner"
LIB="$RUN/lib"
ART="$REPO/artifacts"
LOGDIR="$REPO/logs"
# Consumed by a sourced lib (shellcheck cannot follow `.` sources).
# shellcheck disable=SC2034
MANIFEST="$REPO/data/targets.json"   # runner/lib/select.sh

# --------------------------------------------------------------- config -------
SERIAL="${SERIAL:-}"
# Empty means take the built-in GhostLock path and read no manifest, which needs
# no resolver, python3 or target directory.
RECIPE="${RECIPE:-}"
TARGET="${TARGET:-}"
PRINT_CONTRACT=0
# --debug-panic: a run mode. Stage the payload, wait for the phone to panic and
# reboot (triggered however the operator is studying the crash), then root the
# fresh post-panic boot IN PLACE (no reboot) and dump its pstore. For reading a
# kernel panic's record, which only root can read and a reboot would clear.
DEBUG_PANIC=0
MANAGER_PKG="${MANAGER_PKG:-}"
KMI="${KMI:-}"                       # empty => resolved from the running kernel
CLIENT_UID="${CLIENT_UID:-2000}"     # adb shell uid; the exploit grants it root
APP_UID="${APP_UID:-}"               # empty => derived from the manager package
# Every root this runner has recorded arrived by shot 9, and most by shot 3:
# shots 3, 9, 3 in the archived 20260902 runs, and 3 and 2 on 20260907. Panics
# before a win: 2, then 1. So 12 attempts and 10 panics bound the observed
# distribution with room to spare, where 40 and 40 licensed 88 shots and half an
# hour of pure rebooting before giving up. Raise them for a hunt on a target
# whose distribution is not known.
ROOT_MAX="${ROOT_MAX:-12}"
VERIFY_TRIES="${VERIFY_TRIES:-30}"
# Consumed by runner/lib/exploit.sh and runner/lib/adb.sh.
# shellcheck disable=SC2034
REFUSED_MAX="${REFUSED_MAX:-8}"
# shellcheck disable=SC2034
PANIC_MAX="${PANIC_MAX:-10}"
# shellcheck disable=SC2034
REFUSED_WALL="${REFUSED_WALL:-5}"
# SHOT_TIMEOUT is derived from measured win times. The 16 winning shots of the
# original hand-timed campaign took, in seconds:
#
#     77 79 94 101 113 161 202 304 306 312 332 335 358 360 368 392
#     n=16  min=77  median=305  mean=243.4  sd=119.9  max=392
#
# Two independent estimators land in the same place: mean+3sd = 603 s, and 1.5x
# the slowest observed win = 588 s. 600 s satisfies both. It clears the slowest
# recorded win (392 s) by 208 s — 1.53x — and the slowest recorded panic (339 s)
# by 261 s, so no shot that has ever produced a result would be cut short.
#
# A stage emitting no *_HEARTBEAT marker is PARKED rather than SIGKILLed
# (runner/lib/exploit.sh), so a large timeout costs bounded latency on a hung
# shot.
#
# To re-derive: every shot's wall time is column 6 of logs/shots/<run>/index.tsv
# (time, seq, outcome, restore, rc, wall, file), so the win distribution is
#
#     awk -F'\t' '$3=="PASS"{print $6}' logs/shots/*/index.tsv
#
# Only a handful of runs are archived at a time — logs/ is gitignored — so
# re-derive once enough of them have accumulated rather than from a single run.
# shellcheck disable=SC2034
SHOT_TIMEOUT="${SHOT_TIMEOUT:-600}"
# shellcheck disable=SC2034
SETTLE_SECS="${SETTLE_SECS:-45}"

while [ $# -gt 0 ]; do
  case "$1" in
    --serial)  SERIAL="$2"; shift 2 ;;
    --manager) MANAGER_PKG="$2"; shift 2 ;;
    --kmi)     KMI="$2"; shift 2 ;;
    --recipe)  RECIPE="$2"; shift 2 ;;
    --target)  TARGET="$2"; shift 2 ;;
    --debug-panic) DEBUG_PANIC=1; shift ;;
    --print-contract) PRINT_CONTRACT=1; shift ;;
    # Print the header block: line 2 to the first non-comment line.
    -h|--help) sed -n '2,${/^#/!q;p;}' "$0"; exit 0 ;;
    *) printf 'unknown argument: %s\n' "$1" >&2; exit 64 ;;
  esac
done

# device-side paths (DEV_SU / DEV_LOG are consumed by sourced libs)
DEV_TMP=/data/local/tmp
DEV_HELPER="$DEV_TMP/cve-helper"
DEV_PAYLOAD="$DEV_TMP/exploit-payload.so"
DEV_KSUD="$DEV_TMP/ksud-manager"
# Where a device-exec entry is staged. Overwritten from the manifest's
# [invoke].dest by load_entry_contract; unused by the GhostLock path.
# shellcheck disable=SC2034
DEV_ENTRY="$DEV_TMP/entry-stage"      # runner/lib/exploit.sh
# shellcheck disable=SC2034
DEV_SU="$DEV_TMP/su"                  # runner/lib/adb.sh (asu)
# shellcheck disable=SC2034
DEV_LOG="$DEV_TMP/exploit.log"        # runner/lib/exploit.sh
# Per-boot dirty journal: holds the btime of a boot on which a restore debt
# could not be discharged, so neither a later shot nor a later run composes
# over damaged kernel state (runner/lib/exploit.sh:classify_shot).
# shellcheck disable=SC2034
DEV_DIRTY="$DEV_TMP/exploit.dirty"    # runner/lib/exploit.sh
# KernelSU's own su, used for teardown: the temp-su daemon is dead by then.
# shellcheck disable=SC2034
DEV_KSU_SU=/system/bin/su             # runner/lib/install.sh (teardown_staging)
# apex bin dir the exploit mounts a tmpfs over to stage its temp su; it precedes
# /system/bin in the shell PATH, which is why it must be unmounted afterwards.
# shellcheck disable=SC2034
SU_SHADOW_DIR=/apex/com.android.virt/bin   # runner/lib/install.sh (teardown_staging)

WORKDIR="$(mktemp -d)"
trap 'rm -rf "$WORKDIR"' EXIT

RUNSTAMP="$(date +%Y%m%d-%H%M%S)"
RUNLOG="$LOGDIR/run-$RUNSTAMP.log"
# One archived device log per shot, so a panic's evidence survives the shot that
# follows it.
# shellcheck disable=SC2034
SHOTDIR="$LOGDIR/shots/$RUNSTAMP"     # runner/lib/exploit.sh
# --print-contract opens no run: no run log, no per-run shot archive.
if [ "$PRINT_CONTRACT" = 1 ]; then RUNLOG=/dev/null; else mkdir -p "$LOGDIR" "$SHOTDIR"; fi

# shellcheck source=runner/lib/log.sh
. "$LIB/log.sh"
# shellcheck source=runner/lib/adb.sh
. "$LIB/adb.sh"
# shellcheck source=runner/lib/select.sh
. "$LIB/select.sh"
# shellcheck source=runner/lib/exploit.sh
. "$LIB/exploit.sh"
# shellcheck source=runner/lib/install.sh
. "$LIB/install.sh"

# =============================================================== preflight ====
step "Preflight"

# One runner per device, enforced.
#
# Two runners driving the same phone fire exploits into the same kernel at the
# same time. They corrupt each other's shots, each reads the other's output out
# of the shared device log, and the concurrency itself can panic the kernel --
# so the resulting PANIC is an artefact of the collision. The lock is held for
# the life of the process and released
# by the kernel when it exits, so a killed run leaves nothing to clean up.
# --print-contract touches no phone and takes no lock.
if [ "$PRINT_CONTRACT" != 1 ]; then
  # ANDROID_SERIAL selects the device just as --serial does, so the lock has to
  # see it too, or every run on every device shares one "default" lock.
  _lock="${TMPDIR:-/tmp}/pixel-ksu-root.${SERIAL:-${ANDROID_SERIAL:-default}}.lock"

  # The lock records a pid; it is not an flock.
  #
  # An flock lives on a file descriptor, and every child inherits it: not just
  # the shot and the log stream, but each adb invocation and, worst of all, the
  # adb server daemon, which outlives every run that started it. Any one of them
  # keeps the lock held long after the runner is gone, and Ctrl-C leaves the file
  # behind with no owner at all. A recorded pid has neither problem -- liveness
  # is checked when the lock is contested, and a lock whose owner is gone is
  # simply taken.
  #
  # The lock records the holder's pid AND the boot (btime) it is driving. It is
  # genuinely held only by a live runner on the SAME boot; a runner that crashed
  # and rebooted the phone leaves a lock whose btime is a boot ago, which the
  # next run simply takes. One host process holds one lock for its whole life --
  # including --debug-panic, which keeps holding it across the panic reboot it is
  # there to catch, since the host process never dies.
  _lock_write() {
    printf 'pid %s btime %s started %s by %s\n' \
      "$$" "$(boot_epoch)" "$(date +%H:%M:%S)" "${USER:-?}" >"$_lock"
  }
  # 0 = we now hold it; 1 = a live runner holds it on THIS boot.
  _lock_take() {
    if ( set -o noclobber; : >"$_lock" ) 2>/dev/null; then _lock_write; return 0; fi
    local hpid hbt curbt
    hpid="$(awk '{print $2}' "$_lock" 2>/dev/null)"
    hbt="$(awk '{print $4}' "$_lock" 2>/dev/null)"
    curbt="$(boot_epoch)"
    if [ -n "$hpid" ] && kill -0 "$hpid" 2>/dev/null &&
       tr '\0' ' ' < "/proc/$hpid/cmdline" 2>/dev/null | grep -q pixel-ksu-root &&
       [ -n "$hbt" ] && [ "$hbt" = "$curbt" ]; then
      return 1
    fi
    _lock_write; return 0   # dead holder, or its boot is gone -> steal
  }
  # Release only if we still own it (a stolen lock now names someone else).
  _lock_owned() { [ "$(awk '{print $2}' "$_lock" 2>/dev/null)" = "$$" ]; }
  if ! _lock_take; then
    err "another pixel-ksu-root is already driving ${SERIAL:-${ANDROID_SERIAL:-this device}}"
    err "  held by: $(cat "$_lock" 2>/dev/null)"
    err "  lock: $_lock"
    err "running two exploits against one kernel corrupts both and can panic the"
    err "  phone. Wait for that run to finish, or stop it first."
    exit 1
  fi
  # Interrupting the runner does not stop the exploit.
  #
  # The payload runs on the phone, under an adb shell the runner merely waits on.
  # Kill the runner and the payload keeps racing the kernel unattended, and
  # panics it minutes later -- long enough to reboot away a root some LATER run
  # has already won. An abort therefore stops the device side too. A normal exit
  # does not: by then the payload is finished, and cve-helper is also the temp-su
  # daemon that late-load tears down on its own schedule.
  _release_lock() { _lock_owned && rm -f "$_lock"; rm -rf "$WORKDIR"; }
  _abort() {
    trap - INT TERM EXIT
    warn "interrupted — stopping the payload on the device"
    [ -n "${SHOT_STREAM_PID:-}" ] && kill "$SHOT_STREAM_PID" 2>/dev/null
    [ -n "${SHOT_CLIENT_PID:-}" ] && kill "$SHOT_CLIENT_PID" 2>/dev/null
    # --debug-panic phase 1 runs the trigger in its own process group; stop the
    # whole tree and its device-side racer, or it keeps crashing the phone.
    [ -n "${_tpid:-}" ] && kill -TERM -"$_tpid" 2>/dev/null
    "${ADB[@]}" shell "pkill -f '$DEV_HELPER'; pkill -f '$DEV_ENTRY'" >/dev/null 2>&1 || true
    _release_lock
    exit "${1:-130}"
  }
  trap '_release_lock' EXIT
  trap '_abort 130' INT
  trap '_abort 143' TERM
fi

# --print-contract with an explicit TARGET is a pure host-side question and must
# not need a phone; every other path still starts by waiting for one.
if [ "$PRINT_CONTRACT" = 1 ] && [ -n "$TARGET" ]; then
  log "host-only: printing the contract for TARGET=$TARGET, no device required"
else
  wait_boot || { err "device not ready"; exit 1; }
fi

# ---- recipe selection ------------------------------------------------------
# The operator names a recipe exactly as the build does, and it is resolved by
# the same runner/scripts/resolve-recipe.py against the same runner/recipes/ and runner/stages/, with
# the same ARCH-G* gates. One recipe name, one resolver for build and run.
#
# With RECIPE unset nothing here runs and runner/lib/exploit.sh keeps its
# built-in GhostLock defaults.
# --debug-panic with a recipe: that recipe is the panic TRIGGER, not the thing
# that roots. The rooter is always GhostLock -- it reads the pstore the trigger's
# panic leaves. So the trigger name is set aside and the primary contract is
# forced back to the built-in GhostLock default; phase 1 (below) loads the
# trigger contract on its own to fire it, then restores GhostLock for phase 2.
TRIGGER_RECIPE=""
if [ "${DEBUG_PANIC:-0}" = 1 ] && [ -n "$RECIPE" ] && [ "$RECIPE" != ghostlock ]; then
  TRIGGER_RECIPE="$RECIPE"
  RECIPE="ghostlock"
fi
# shellcheck disable=SC2034  # ENTRY_RECIPE is read by runner/lib/exploit.sh:print_contract
ENTRY_RECIPE="$RECIPE"
if [ -n "$RECIPE" ]; then
  if [ -z "$TARGET" ]; then
    TARGET="$(getprop ro.product.device)-$(getprop ro.build.display.id)"
  fi
  log "recipe '$RECIPE' selected for $TARGET — resolving stages the way the build does"
  load_entry_contract "$RECIPE" "$TARGET" "$RUN" || {
    err "run  make -C $REPO/cves TARGET=$TARGET RECIPE=$RECIPE check  for the same gate"
    exit 2
  }
  ok "entry $ENTRY_ID  invoke=$INVOKE_KIND  composed=$ENTRY_COMPOSED  provides=[${PROVIDES_CAPS:-}]"
  log "  status: $ENTRY_STATUS"
fi

if [ "$PRINT_CONTRACT" = 1 ]; then
  step "Runner contract (${RECIPE:-built-in default, no manifest read})"
  print_contract
  exit 0
fi

if chain_has_su; then
  if [ -z "$MANAGER_PKG" ]; then
    log "no MANAGER_PKG set — scanning installed packages for a KernelSU manager"
    MANAGER_PKG="$(detect_manager || true)"
    [ -n "$MANAGER_PKG" ] || { err "no KernelSU manager found — set MANAGER_PKG"; exit 1; }
    ok "auto-detected manager: $MANAGER_PKG"
  fi

  # The exploit daemon authorizes one app uid; default it to the manager's uid.
  if [ -z "$APP_UID" ]; then
    APP_UID="$(manager_uid "$MANAGER_PKG")"
    [ -n "$APP_UID" ] || { err "manager $MANAGER_PKG not installed"; exit 1; }
  fi
else
  # The chain declares no CAP_SU handoff, so it cannot install anything and
  # there is nothing for a manager to authorize. This is a HUNT: drive the
  # entry, classify and archive every shot, install nothing.
  warn "chain '${RECIPE}' provides [${CHAIN_CAPS:-none}] — no CAP_SU handoff"
  warn "this is a HUNT, not a root: no manager detection, no ksud, no late-load"
fi

# =============================================================== resolve =======
step "Resolve target"
resolve_target; rc=$?
if [ $rc -eq 1 ]; then err "target resolution failed"; exit 1; fi
log "device=$TARGET_CODENAME build=$BUILD kernel=$KREL kmi=$KMI manager=$MANAGER_PKG uid=$APP_UID"
if [ $rc -eq 2 ]; then
  err "device $TARGET_CODENAME ($BUILD, kernel $KREL) is not a supported target"
  err "the exploit cannot run here (kernel resolves kmi=$KMI only). supported targets:"
  python3 - "$MANIFEST" <<'PY' 2>/dev/null | sed 's/^/    /' | while read -r l; do err "$l"; done
import json, sys
for e in json.load(open(sys.argv[1]))["devices"]:
    print("%s-%s" % (e["codename"], e["build"]))
PY
  err "to add this device: harvest it (runner/scripts/harvest-live.sh) and add a data/targets.json row"
  exit 1
fi

# =============================================================== derive ksud ===
# ksud must come from the installed manager (the ko is signature-locked to it).
# Both this and the resident-module early exit belong to the CAP_SU handoff; a
# hunt chain has neither, and must not be short-circuited by a KernelSU that is
# already loaded — the point of the run is the entry, not the module.
if chain_has_su; then
  step "Derive ksud from installed manager ($MANAGER_PKG)"
  derive_ksud || exit 1

# Save the kernel's record of a panic this run caused.
#
# pstore/ramoops holds the oops that rebooted the phone, it is root-only, and it
# keeps only the most recent one. A run that panicked on the way to root reaches
# the one moment the record is readable when it finally wins root, so it is
# taken there and written to the run's log directory.
capture_panic_evidence() {
  local reason dst
  # Only a panic this run caused is ours to explain. pstore keeps just the most
  # recent record and root is the only way to read it, so a run that panicked on
  # the way to root must take it here or lose it.
  [ "${PANICS_SEEN:-0}" -gt 0 ] || return 0
  reason="$(getprop sys.boot.reason.last)"
  dst="$LOGDIR/panic-$RUNSTAMP"
  mkdir -p "$dst"
  warn "this run panicked ${PANICS_SEEN} time(s) (last boot ended in: ${reason:-unknown}) — saving the kernel's record"
  # The temp su exists only right after the exploit; on an already-rooted device
  # KernelSU's own su is what answers. Pick whichever works.
  local su_cmd=""
  if asu "id" 2>/dev/null | strip | grep -q 'uid=0'; then
    su_cmd="asu"
  elif ash "$DEV_KSU_SU -c id" 2>/dev/null | strip | grep -q 'uid=0'; then
    su_cmd="ksu"
  else
    warn "  no root available to read pstore — panic record not saved"
    rmdir "$dst" 2>/dev/null || true
    return 0
  fi
  local f
  for f in console-ramoops-0 dmesg-ramoops-0 pmsg-ramoops-0; do
    if [ "$su_cmd" = asu ]; then
      asu "cat /sys/fs/pstore/$f" 2>/dev/null | strip > "$dst/$f.txt" 2>/dev/null || true
    else
      ash "$DEV_KSU_SU -c \"cat /sys/fs/pstore/$f\"" 2>/dev/null | strip > "$dst/$f.txt" 2>/dev/null || true
    fi
    [ -s "$dst/$f.txt" ] || rm -f "$dst/$f.txt"
  done
  if ls "$dst"/*.txt >/dev/null 2>&1; then
    ok "  panic record saved: $dst"
    # Print the oops itself: the fault line, pc/lr, the faulting task, and the
    # call trace's FRAMES -- not a bare "Call trace:" with nothing under it, and
    # not the kernel command line, which a naive KASAN match pulls in because
    # the cmdline carries kasan.* parameters. Everything from the first oops
    # marker, the frames indented under the first trace, and nothing after it.
    awk '
      /Unable to handle|kernel BUG at|Internal error: Oops/ { if (!seen) seen = 1 }
      !seen { next }
      /Modules linked in|^\[PRE\]|Kernel command line/ { next }
      /Unable to handle|kernel BUG at|Internal error|CPU: |Comm: |pc : |lr : |Kernel panic/ { print; next }
      /Call trace:/ { intrace = 1; print; next }
      intrace {
        # a frame looks like "[ time][ tid]  symbol+0x.../0x..."
        if ($0 ~ /\+0x[0-9a-f]+\/0x[0-9a-f]+/) { print; frames++; if (frames < 14) next }
        exit
      }
    ' "$dst"/console-ramoops-0.txt 2>/dev/null \
      | sed -E 's/^\[[^]]*\]\[[^]]*\] ?//' | head -22 \
      | while read -r l; do log "    $l"; done
  else
    warn "  pstore held nothing readable for this boot"
    rmdir "$dst" 2>/dev/null || true
  fi
}

  # A resident module needs no further work — probe with a plain-shell syscall.
  # Except in --debug-panic: the whole point is to run the trigger, panic the
  # phone (which unloads the RAM-resident module), and re-root the fresh boot, so
  # a module resident right now must NOT short-circuit the run.
  if [ "${DEBUG_PANIC:-0}" != 1 ] && ksu_loaded "$DEV_KSUD"; then
    step "KernelSU already loaded"
    ash "$DEV_KSUD debug info" 2>&1 | strip | tee_log
    # An earlier run in this same boot may have left its staging mount behind.
    teardown_staging
    ok "SUCCESS — KernelSU already resident (version=$(ksu_version "$DEV_KSUD")). Log: $RUNLOG"
    exit 0
  fi
fi

# =============================================================== obtain root ===
# Two invocation shapes, two things to stage. device-exec pushes ONE
# static binary — the artifact `make TARGET=<t> RECIPE=<r>` produced for this
# exact target, named by the manifest, so the binary that runs is by
# construction the binary that was built.
if [ "$INVOKE_KIND" = device-exec ]; then
  step "Push entry binary ($ENTRY_ID)"
  if [ -z "$ENTRY_ARTIFACT" ] || [ ! -f "$ENTRY_ARTIFACT" ]; then
    err "entry binary missing: ${ENTRY_ARTIFACT:-<none declared>}"
    err "build it:  make -C $REPO/cves TARGET=$TARGET RECIPE=$RECIPE"
    exit 2
  fi
  apush_verified "$ENTRY_ARTIFACT" "$DEV_ENTRY" || exit 2
  ash "chmod ${ENTRY_MODE:-755} $DEV_ENTRY" 2>/dev/null
else
  if [ $rc -eq 2 ]; then err "cannot obtain root without a payload"; exit 2; fi

  step "Push exploit artifacts"
  if [ ! -f "$ART/cve-helper" ] || [ ! -f "$EXPLOIT_PATH" ]; then
    _t="${TARGET:-$TARGET_CODENAME-$BUILD}"; _r="${RECIPE:-ghostlock}"
    err "exploit artifacts missing — build them before rooting:"
    [ -f "$ART/cve-helper" ] || err "  missing  $ART/cve-helper"
    [ -f "$EXPLOIT_PATH" ]   || err "  missing  $EXPLOIT_PATH  (payload $EXPLOIT_FILE)"
    err "build all payloads:  runner/scripts/build-payloads.sh   (needs ANDROID_HOME or ANDROID_NDK_HOME)"
    err "or just this target:  make -C $REPO/cves TARGET=$_t RECIPE=$_r all release"
    exit 2
  fi
  apush_verified "$ART/cve-helper" "$DEV_HELPER" || exit 2
  apush_verified "$EXPLOIT_PATH"   "$DEV_PAYLOAD" || exit 2
  # Re-push whatever a panic reboot lost. A panic does not flush the filesystem,
  # so a file written before it can come back the right size with uncommitted
  # data blocks -- all NUL. A gutted payload starts and prints nothing, which is
  # indistinguishable from a refusal, so the run burns its refusal budget and
  # reboots instead of reporting the real cause. obtain_root calls this after
  # every panic; it is a no-op when the copies still match.
  recheck_artifacts() {
    local pair src dst want got rc=0
    # ksud is included: it is derived from the manager's APK through the package
    # manager, which a device sitting at the lock screen after a reboot cannot be
    # relied on to answer. It is extracted once, before any reboot, and restored
    # from that host copy afterwards -- never re-derived.
    for pair in "$ART/cve-helper:$DEV_HELPER" "$EXPLOIT_PATH:$DEV_PAYLOAD" \
                "${KSUD_HOST:-}:$DEV_KSUD"; do
      src="${pair%%:*}"; dst="${pair##*:}"
      [ -f "$src" ] || continue
      want="$(md5sum "$src" 2>/dev/null | awk '{print $1}')"
      got="$(ash "md5sum $dst 2>/dev/null" | tr -d '\r' | awk '{print $1}')"
      [ -n "$want" ] && [ "$want" = "$got" ] && continue
      warn "  $dst no longer matches the host build — re-pushing"
      apush_verified "$src" "$dst" || rc=1
      ash "chmod 755 $dst" 2>/dev/null
    done
    return $rc
  }
  ash "chmod 755 $DEV_HELPER $DEV_PAYLOAD" 2>/dev/null
fi

if root_oracle && [ "${DEBUG_PANIC:-0}" != 1 ]; then
  ok "already rooted — skipping exploit"
else
  # A reboot can land the device on the lock screen, where the package manager is
  # not dependable. Everything derived from it -- the manager package, its uid,
  # and ksud extracted from its APK -- is already resolved by this point, so
  # confirm the on-device copies are complete before the first reboot rather than
  # discovering a gap after one.
  if plan_reboots; then
    step "Stage everything before rebooting"
    _missing=""
    for _f in "$DEV_HELPER" "$DEV_PAYLOAD" "$DEV_KSUD"; do
      ash "test -s $_f" >/dev/null 2>&1 || _missing="$_missing $_f"
    done
    if [ -n "$_missing" ]; then
      err "not staged on the device:$_missing"
      err "a reboot precedes every shot and these cannot be re-derived from a"
      err "locked device. Fix the staging above."
      exit 2
    fi
    ok "  helper, payload and ksud are on the device and survive a reboot"
  fi

  # --debug-panic: GhostLock is staged. Get to a fresh post-panic boot, then root
  # it IN PLACE (SKIP_SETUP, so no reboot -- a reboot would wipe the pstore record
  # this mode exists to read). One host process holds one lock throughout; it
  # never dies across the device reboot, so nothing is handed off.
  if [ "${DEBUG_PANIC:-0}" = 1 ]; then
    if [ -n "$TRIGGER_RECIPE" ]; then
      # Phase 1: fire the trigger recipe until it panics the phone, watched by a
      # second adb connection that returns the instant the phone drops. The
      # trigger runs in its own process group so that, on the drop, the whole tree
      # is killed at once -- before it can retry or reboot and clear the record.
      _tt="${TARGET:-$TARGET_CODENAME-$BUILD}"
      step "Debug-panic phase 1: fire trigger '$TRIGGER_RECIPE', watch the connection"
      load_entry_contract "$TRIGGER_RECIPE" "$_tt" "$RUN" || {
        err "trigger recipe '$TRIGGER_RECIPE' did not resolve for $_tt"; exit 2; }
      if [ "$INVOKE_KIND" = device-exec ]; then
        if [ -z "$ENTRY_ARTIFACT" ] || [ ! -f "$ENTRY_ARTIFACT" ]; then
          err "trigger entry binary missing: ${ENTRY_ARTIFACT:-<none>}"
          err "build it:  make -C $REPO/cves TARGET=$_tt RECIPE=$TRIGGER_RECIPE"
          exit 2
        fi
        apush_verified "$ENTRY_ARTIFACT" "$DEV_ENTRY" || exit 2
        ash "chmod ${ENTRY_MODE:-755} $DEV_ENTRY" 2>/dev/null
      fi
      # Commit every staged file to disk before provoking the panic. A panic does
      # not flush the filesystem, so a file with uncommitted blocks comes back
      # NUL-filled on the next boot; one sync now is what lets phase 2 trust the
      # GhostLock payload without re-checking it per shot.
      ash "sync" >/dev/null 2>&1
      # Run the trigger in its own process group (set -m) so the whole tree can be
      # killed at once. Watch the connection in a parallel subshell that blocks on
      # `adb shell cat` and returns the instant the phone drops.
      set -m
      ( run_trigger_loop ) & _tpid=$!
      set +m
      wait_connection_drop & _wpid=$!
      # Three outcomes, decided by whichever of the two local pids ends first (a
      # cheap poll, no device traffic) within a bounded wait:
      #   - the watcher exits  -> the phone dropped: the panic we wanted.
      #   - the trigger exits  -> it stopped WITHOUT a panic (could not run/ran out).
      #   - neither, by the deadline -> the trigger runs but does not panic (e.g. a
      #     benign detection harness); give up rather than wait forever.
      _deadline=$(( $(date +%s) + ${DEBUG_PANIC_TIMEOUT:-600} ))
      while kill -0 "$_wpid" 2>/dev/null && kill -0 "$_tpid" 2>/dev/null \
            && [ "$(date +%s)" -lt "$_deadline" ]; do sleep 0.5; done
      if kill -0 "$_wpid" 2>/dev/null; then
        # Watcher still blocked => no drop. Trigger dead = "ran out"; alive = timed out.
        if kill -0 "$_tpid" 2>/dev/null; then
          err "trigger '$TRIGGER_RECIPE' ran ${DEBUG_PANIC_TIMEOUT:-600}s without panicking the phone — giving up"
          err "  (raise DEBUG_PANIC_TIMEOUT, or use a trigger that actually panics the kernel)"
        else
          err "trigger '$TRIGGER_RECIPE' stopped without panicking the phone — see the log above"
        fi
        kill "$_wpid" 2>/dev/null; pkill -P "$_wpid" 2>/dev/null
        kill -TERM -"$_tpid" 2>/dev/null
        "${ADB[@]}" shell "pkill -f '$DEV_ENTRY'" >/dev/null 2>&1 || true
        wait 2>/dev/null || true
        exit 2
      fi
      warn "  connection lost — the trigger panicked the phone; stopping it"
      kill -TERM -"$_tpid" 2>/dev/null || true
      wait 2>/dev/null || true
      wait_device_back || { err "device did not come back after the panic"; exit 1; }
      # Phase 2: restore the GhostLock contract the trigger overwrote and root this
      # fresh boot in place.
      step "Debug-panic phase 2: GhostLock roots the post-panic boot in place"
      load_entry_contract "ghostlock" "$_tt" "$RUN" || { err "ghostlock did not resolve"; exit 2; }
    else
      # No trigger recipe: the operator provokes the panic themselves; just wait
      # for the phone to drop and come back.
      step "Armed — waiting for a panic reboot (trigger the crash now)"
      wait_for_reboot
    fi
    SKIP_SETUP=1
    PANICS_SEEN=1   # force the pstore dump even though this run did not cause it
  fi

  obtain_root; orc=$?
  if [ $orc -ne 0 ]; then
    case $orc in
      3) err "aborted: a stage precondition failed — per-shot logs in $SHOTDIR" ;;
      4) err "HELD — the exploit is holding a live kernel hook; the device was NOT rebooted."
         err "This is the furthest CVE-2026-64560 reaches (forged bridge installed, not"
         err "converted to root). Examine the live bridge, or 'adb reboot' to recover."
         err "Per-shot logs in $SHOTDIR"
         exit 4 ;;
      *) if chain_has_su; then
           err "failed to obtain root — per-shot logs in $SHOTDIR"
         else
           # Expected for a hunt chain: it has no handoff, so it has no way to
           # reach root at all. The evidence, not the verdict, is the product.
           err "hunt finished without root — every shot is classified in $SHOTDIR/index.tsv"
           # Name the CVE this run actually hunted, not a hardcoded one: every
           # hunt recipe reached this line and was told about 64560.
           err "${ENTRY_CVE:-this chain} has never rooted a device; see its README under cves/"
         fi ;;
    esac
    exit 2
  fi
fi
ok "ROOT: $(asu id | strip)"
capture_panic_evidence


# =============================================================== install ======
if install_ksu; then
  # Root is live; drop the exploit's PATH shadow so `adb shell su` reaches
  # KernelSU's su instead of the temp su whose daemon late-load just killed.
  teardown_staging
  step "Kernel evidence (driver self-report, no root needed)"
  ash "$DEV_KSUD debug info" 2>&1 | strip | tee_log
  ok "SUCCESS — KernelSU is loaded and answering (version=${KSU_VER:-?}). Full log: $RUNLOG"
  exit 0
else
  err "root was obtained, but the KernelSU driver never came up. Full log: $RUNLOG"
  exit 3
fi
